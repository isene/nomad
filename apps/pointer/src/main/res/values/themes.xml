<resources>
    <!-- Only the window behind the first frame; Compose paints the rest. -->
    <style name="Theme.Pointer" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The share sheet: the app that shares stays in view behind it. -->
    <style name="Theme.Pointer.Share">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
