<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Coarse is enough for weather: the forecast is asked for a point on
         a one-kilometre grid. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- For the widget: to be run on the full hour, when the tick of the
         hour moves. The alarm never wakes a sleeping phone. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- For the widget: the clock app asks for this of whoever opens its
         list of alarms. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- For the widget's dot: to keep a watch on one folder while the dot
         is switched on, and to start that watch again with the phone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- For the widget: to list the apps a tap on it can open. Only apps
         with an icon in the launcher are seen, and the list is read only
         while it is on screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Outside">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Outside">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ClockWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget" />
        </receiver>

        <!-- Off until a widget is placed, so a phone without one never
             starts the app for these. -->
        <receiver
            android:name=".WidgetEvents"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".WidgetSound"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Up only while the dot is switched on in the app. -->
        <service
            android:name=".InboxWatch"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches one folder for waiting messages and marks them on the home-screen widget" />
        </service>
    </application>

</manifest>
