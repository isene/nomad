<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The line that makes the ColorOS Home button work: launchers without
         SYSTEM_ALERT_WINDOW never appear in ColorOS's "Display over other
         apps" allowlist and can't be brought back over a fullscreen app. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- An icon in the app panel that calls a number. Both are asked for
         when the user adds the first such icon, and both may be refused:
         with no CALL_PHONE a tap opens the dialler with the number in it,
         with no READ_CONTACTS the icon is a letter and not the picture. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- AppWidget hosting. BIND_APPWIDGET is signature-level for system
         launchers; standard launchers go through the user-consent
         ACTION_APPWIDGET_BIND flow instead, which is what we do. -->
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />

    <!-- Battery optimization exception so ColorOS doesn't phantom-kill us. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Keep-alive foreground service: ColorOS freezes third-party launchers,
         which is the root cause of the dead Home button (confirmed community
         finding, dontkillmyapp.com/oppo). The service executes NO code — no
         timers, no threads — it exists purely to pin process priority. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 11+ package visibility: without this, installedProviders only
         returns SYSTEM apps' widgets (the user saw 4). A widget host must see
         every app's providers. Sideload-only app, so QUERY_ALL_PACKAGES is
         fine (Play policy doesn't apply). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <queries>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnePage">

        <!-- HOME activity. stateNotNeeded + excludeFromRecents are the
             standard launcher posture; configChanges keeps rotation and
             ui-mode flips from recreating the always-alive Activity. -->
        <activity
            android:name=".HomeActivity"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- First-run wizard (Compose). Launched until setup completes. -->
        <activity
            android:name=".WizardActivity"
            android:exported="false"
            android:theme="@style/Theme.OnePage.Wizard" />

        <!-- An app's "Add to Home screen" lands here: a contact, a chat, a
             web page. It goes into the app panel. Shows nothing. -->
        <activity
            android:name=".PinActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- Opens the phone's contact list for a number to put in the app
             panel. See-through: it shows nothing of its own. A task of its
             own, so the app the user was in is back when it is done. -->
        <activity
            android:name=".ContactActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The swipe up from the bottom edge that opens the app panel in
             any app. Off until the user switches it on under Accessibility.
             Only Android can bind it. -->
        <service
            android:name=".EdgeService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/edge_service" />
        </service>

        <!-- Inert keep-alive (see the permission comment above). -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Launcher keep-alive: prevents the OEM from freezing the home app so the Home button keeps working" />
        </service>

    </application>

</manifest>
