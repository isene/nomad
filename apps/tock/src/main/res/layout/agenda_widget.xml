<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: today's date, a plus for a new event, and the
     coming days as a list that scrolls. AgendaWidget fills in the rest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_back"
    android:backgroundTint="#00000000"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    tools:ignore="HardcodedText,SpUsage">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- A tap opens tock. -->
        <TextView
            android:id="@+id/title"
            style="@style/WidgetText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:text="Tuesday 13 October"
            android:textSize="15dp"
            android:textStyle="bold" />

        <!-- A tap starts a new event. -->
        <TextView
            android:id="@+id/add"
            style="@style/WidgetText"
            android:layout_width="wrap_content"
            android:contentDescription="@string/widget_add"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="+"
            android:textSize="22dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/empty"
        style="@style/WidgetText.Dim"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:maxLines="3"
        android:text="@string/widget_empty" />
</LinearLayout>
